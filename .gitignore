# FoldForge keeps weights, databases, release environments and runs outside the
# repository, under $FOLDFORGE_HOME (default ~/.cache/foldforge; see
# src/foldforge/paths.py). Nothing machine-specific belongs in the checkout.

# Python
__pycache__/
*.py[cod]
.venv/
.venv-*/
*.egg-info/
.pytest_cache/
.ruff_cache/
uv.lock.bak
build/
dist/

# Slurm logs from jobs submitted at the repo root
slurm-*.out
slurm-*.log
slurm-*.err
